# Hostinger paper/shadow profile. Compose also hard-overrides all live controls off.
LOG_LEVEL=INFO
TRADING_MODE=paper
EXECUTION_MODE=paper
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ARMED=false
LIVE_EXECUTION_MODE=paper
GLOBAL_PAUSE=false

MARKET_DATA_ENABLED=true
MARKET_DATA_SYMBOLS=BTCUSDT,ETHUSDT
SHADOW_MODE_ENABLED=true
SHADOW_AUTO_APPROVE=true

ENABLE_PROVIDER_HEALTH=true
ENABLE_PROVIDER_HEALTH_VETO=true
ENABLE_MIROFISH=true
MIROFISH_PROVIDER=external
MIROFISH_BASE_URL=http://mirofish:5001
MIROFISH_VERIFY_TLS=true
MIROFISH_TIMEOUT_MS=3000
MIROFISH_MAX_DATA_AGE_SECONDS=300
MIROFISH_MAX_SCENARIO_CONFIDENCE=0.5

# Keep Polymarket explicit and safe until network/legal/provider checks pass on the VPS.
ENABLE_POLYMARKET_ENGINE=true
POLYMARKET_PROVIDER_MODE=mock
LATENCY_ARB_ENABLED=false
LATENCY_ARB_PAPER_ONLY=true

OPS_ENABLED=true
STARTUP_PREFLIGHT_ENABLED=true
REQUIRE_PERSISTENCE_FOR_BOOT=true
RECOVERY_ENABLED=true
