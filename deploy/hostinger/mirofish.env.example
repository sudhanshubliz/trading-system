# Copy to mirofish.env on the VPS and chmod 600. Never commit the populated file.
SECRET_KEY=replace_with_a_long_random_value
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# MiroFish accepts OpenAI-compatible LLM providers. Configure these only on the VPS.
LLM_API_KEY=replace_with_rotated_llm_key
LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_MODEL_NAME=replace_with_model_name

# Use a newly rotated Zep project key. Never reuse a key disclosed in chat or logs.
ZEP_API_KEY=replace_with_rotated_zep_key

# Start conservatively; increase only after measuring CPU, RAM, and LLM cost.
OASIS_DEFAULT_MAX_ROUNDS=20
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
